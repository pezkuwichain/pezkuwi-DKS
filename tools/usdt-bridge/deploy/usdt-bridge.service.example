# usdt-bridge listener — example systemd unit.
# Detects USDT/wUSDT deposit/withdrawal events; auto-pays only sub-cap swaps via a bounded,
# multisig-delegated automation-key allowance, and queues everything else for 3-of-5 approval.
# It can never mint/burn/set_team/transfer_ownership — those stay exclusively with the multisig.
# Copy to /etc/systemd/system/, fill in <PLACEHOLDERS>, and provide secrets ONLY via the
# EnvironmentFile(s) below (never in the repo): BRIDGE_SEED_MNEMONIC / AUTOMATION_KEY_MNEMONIC.
[Unit]
Description=usdt-bridge listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<service-user>
Group=<service-group>
WorkingDirectory=<WORKDIR>
ExecStart=<BIN_DIR>/usdt-bridge --config <CONFIG_PATH>/bridge_config.json listen-all
Environment=RUST_LOG=info
EnvironmentFile=<SECRETS_DIR>/telegram_token.env
EnvironmentFile=-<SECRETS_DIR>/automation_key.env
# POLKADOT_RPC_URL / PEZKUWI_RPC_URL overrides - a metered endpoint's key lives here, not in the
# committed config.
EnvironmentFile=-<SECRETS_DIR>/polkadot_rpc.env
Restart=on-failure
# A refused connection (an exhausted provider quota answers 403 until it resets) fails every
# attempt, so a fixed short delay restarted the bridge 221 times in one night against the same
# refusal. The delay now grows to 30 minutes over 8 restarts; the count only resets on a manual
# start/stop, so a later crash also waits up to 30 minutes - catch-up then covers the gap.
RestartSec=10
RestartSteps=8
RestartMaxDelaySec=30min

# Hardening (recommended baseline)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=<WORKDIR>
UMask=0077

[Install]
WantedBy=multi-user.target
